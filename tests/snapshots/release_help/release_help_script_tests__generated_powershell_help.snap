---
@{
  RootModule = "CustomNetsuke.psm1"
  ModuleVersion = "0.1.0"
}

---
<helpItems schema="maml">
  <command:command xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:maml="http://schemas.microsoft.com/maml/2004/10">
    <command:details>
      <command:name>CustomNetsuke</command:name>
    </command:details>
    <command:description>
      <maml:para>-f/--file FILE -j/--jobs N -v/--verbose --locale LOCALE --fetch-allow-scheme SCHEME --env-allow-var VAR --env-block-var VAR --fetch-allow-host HOST --fetch-block-host HOST --fetch-default-deny --trust-project-fetch-policy --manifest-evaluation-fuel FUEL --manifest-fuel FUEL --manifest-rendered-value-bytes BYTES --manifest-rendered-manifest-bytes BYTES --manifest-source-bytes BYTES --manifest-foreach-cardinality COUNT --manifest-expanded-entries COUNT --json --no-input --color POLICY auto|always|never --emoji POLICY auto|always|never --progress POLICY auto|always|never --accessibility POLICY auto|on|off --default-target TARGET -C/--directory DIR --config FILE build clean graph generate help</maml:para>
    </command:description>
    <command:parameter required="true"><maml:name>--file</maml:name><command:parameterValue required="true">FILE</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--jobs</maml:name><command:parameterValue required="true">N</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--locale</maml:name><command:parameterValue required="true">LOCALE</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--fetch-allow-scheme</maml:name><command:parameterValue required="true">SCHEME</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--env-allow-var</maml:name><command:parameterValue required="true">VAR</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--env-block-var</maml:name><command:parameterValue required="true">VAR</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--fetch-allow-host</maml:name><command:parameterValue required="true">HOST</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--fetch-block-host</maml:name><command:parameterValue required="true">HOST</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--manifest-evaluation-fuel</maml:name><command:parameterValue required="true">FUEL</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--manifest-fuel</maml:name><command:parameterValue required="true">FUEL</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--manifest-rendered-value-bytes</maml:name><command:parameterValue required="true">BYTES</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--manifest-rendered-manifest-bytes</maml:name><command:parameterValue required="true">BYTES</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--manifest-source-bytes</maml:name><command:parameterValue required="true">BYTES</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--manifest-foreach-cardinality</maml:name><command:parameterValue required="true">COUNT</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--manifest-expanded-entries</maml:name><command:parameterValue required="true">COUNT</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--color</maml:name><command:parameterValue required="true">POLICY</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--emoji</maml:name><command:parameterValue required="true">POLICY</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--progress</maml:name><command:parameterValue required="true">POLICY</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--accessibility</maml:name><command:parameterValue required="true">POLICY</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--default-target</maml:name><command:parameterValue required="true">TARGET</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--directory</maml:name><command:parameterValue required="true">DIR</command:parameterValue></command:parameter>
    <command:parameter required="true"><maml:name>--config</maml:name><command:parameterValue required="true">FILE</command:parameterValue></command:parameter>
  </command:command>
</helpItems>

---
TOPIC
    about_CustomNetsuke
