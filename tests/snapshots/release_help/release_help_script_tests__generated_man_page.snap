.TP
\fB--env-allow-var\fR \fIVAR\fP
.TP
\fB--env-block-var\fR \fIVAR\fP
.TP
\fB--fetch-allow-host\fR \fIHOST\fP
.TP
\fB--fetch-block-host\fR \fIHOST\fP
.TP
\fB--manifest-evaluation-fuel\fR \fIFUEL\fP
.TP
\fB--manifest-fuel\fR \fIFUEL\fP
.TP
\fB--manifest-rendered-value-bytes\fR \fIBYTES\fP
.TP
\fB--manifest-rendered-manifest-bytes\fR \fIBYTES\fP
.TP
\fB--manifest-source-bytes\fR \fIBYTES\fP
