---
source: tests/ortho_config_metadata_snapshot_tests.rs
expression: metadata_snapshot()
---
ir_version: "1.1"
precedence:
  - Defaults
  - File
  - Env
  - Cli
discovery: ~
fields:
  - name: file
    help_id: netsuke.fields.file.help
    cli:
      long: file
      short: f
      multiple: false
      possible_values: []
    environment: NETSUKE_FILE
    file: file
    merge_strategy: replace
  - name: jobs
    help_id: netsuke.fields.jobs.help
    cli:
      long: jobs
      short: j
      multiple: false
      possible_values: []
    environment: NETSUKE_JOBS
    file: jobs
    merge_strategy: replace
  - name: verbose
    help_id: netsuke.fields.verbose.help
    cli:
      long: verbose
      short: v
      multiple: false
      possible_values: []
    environment: NETSUKE_VERBOSE
    file: verbose
    merge_strategy: replace
  - name: locale
    help_id: netsuke.fields.locale.help
    cli:
      long: locale
      short: l
      multiple: false
      possible_values: []
    environment: NETSUKE_LOCALE
    file: locale
    merge_strategy: replace
  - name: fetch_allow_scheme
    help_id: netsuke.fields.fetch_allow_scheme.help
    cli:
      long: fetch-allow-scheme
      short: F
      multiple: true
      possible_values: []
    environment: NETSUKE_FETCH_ALLOW_SCHEME
    file: fetch_allow_scheme
    merge_strategy: append
  - name: fetch_allow_host
    help_id: netsuke.fields.fetch_allow_host.help
    cli:
      long: fetch-allow-host
      short: e
      multiple: true
      possible_values: []
    environment: NETSUKE_FETCH_ALLOW_HOST
    file: fetch_allow_host
    merge_strategy: append
  - name: fetch_block_host
    help_id: netsuke.fields.fetch_block_host.help
    cli:
      long: fetch-block-host
      short: E
      multiple: true
      possible_values: []
    environment: NETSUKE_FETCH_BLOCK_HOST
    file: fetch_block_host
    merge_strategy: append
  - name: fetch_default_deny
    help_id: netsuke.fields.fetch_default_deny.help
    cli:
      long: fetch-default-deny
      short: t
      multiple: false
      possible_values: []
    environment: NETSUKE_FETCH_DEFAULT_DENY
    file: fetch_default_deny
    merge_strategy: replace
  - name: json
    help_id: netsuke.fields.json.help
    cli:
      long: json
      short: J
      multiple: false
      possible_values: []
    environment: NETSUKE_JSON
    file: json
    merge_strategy: replace
  - name: no_input
    help_id: netsuke.fields.no_input.help
    cli: ~
    environment: NETSUKE_NO_INPUT
    file: no_input
    merge_strategy: replace
  - name: color
    help_id: netsuke.fields.color.help
    cli: ~
    environment: NETSUKE_COLOR
    file: color
    merge_strategy: replace
  - name: emoji
    help_id: netsuke.fields.emoji.help
    cli: ~
    environment: NETSUKE_EMOJI
    file: emoji
    merge_strategy: replace
  - name: progress
    help_id: netsuke.fields.progress.help
    cli: ~
    environment: NETSUKE_PROGRESS
    file: progress
    merge_strategy: replace
  - name: accessibility
    help_id: netsuke.fields.accessibility.help
    cli: ~
    environment: NETSUKE_ACCESSIBILITY
    file: accessibility
    merge_strategy: replace
  - name: default_targets
    help_id: netsuke.fields.default_targets.help
    cli:
      long: default-targets
      short: d
      multiple: true
      possible_values: []
    environment: NETSUKE_DEFAULT_TARGETS
    file: default_targets
    merge_strategy: append
  - name: cmds
    help_id: netsuke.fields.cmds.help
    cli: ~
    environment: NETSUKE_CMDS
    file: cmds
    merge_strategy: replace
  - name: config
    help_id: cli.flag.config.help
    cli:
      long: config
      short: ~
      multiple: false
      possible_values: []
    environment: ~
    file: ~
    merge_strategy: replace
subcommands:
  - name: build
    about_id: cli.subcommand.build.about
  - name: clean
    about_id: cli.subcommand.clean.about
  - name: graph
    about_id: cli.subcommand.graph.about
  - name: generate
    about_id: cli.subcommand.generate.about
  - name: help
    about_id: cli.subcommand.help.long_about
