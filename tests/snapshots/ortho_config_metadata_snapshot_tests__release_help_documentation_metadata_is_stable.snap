---
source: tests/ortho_config_metadata_snapshot_tests.rs
expression: metadata_snapshot()
---
ir_version: "2.0"
precedence:
  - Defaults
  - File
  - Env
  - Cli
discovery: ~
synopsis_id: ~
fields:
  - name: file
    help_id: cli.flag.file.help
    cli:
      long: file
      short: f
      value_name: FILE
      multiple: false
      possible_values: []
    environment: NETSUKE_FILE
    file: file
    merge_strategy: replace
  - name: jobs
    help_id: cli.flag.jobs.help
    cli:
      long: jobs
      short: j
      value_name: N
      multiple: false
      possible_values: []
    environment: NETSUKE_JOBS
    file: jobs
    merge_strategy: replace
  - name: verbose
