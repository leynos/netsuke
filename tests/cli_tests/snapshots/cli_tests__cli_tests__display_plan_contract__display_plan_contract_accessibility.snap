    output_mode: standard
    emoji_allowed: true
    reporter: standard
    progress:
      enabled: true
      live: false
      force_text_task_updates: true
    stdout_colour: false
    stderr_colour: false
    diagnostics:
      colour: false
      unicode: true
      links: false
- policy: "off"
