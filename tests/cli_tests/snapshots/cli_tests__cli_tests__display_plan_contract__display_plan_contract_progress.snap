---
source: tests/cli_tests/display_plan_contract.rs
expression: "rows_for_policy([(\"auto\", DisplayPolicies\n{ progress: ProgressPolicy::Auto, ..policies() },),\n(\"always\", DisplayPolicies\n{ progress: ProgressPolicy::Always, ..policies() },),\n(\"never\", DisplayPolicies\n{ progress: ProgressPolicy::Never, ..policies() },),])"
---
- policy: auto
  facts: pipe
  plan:
    output_mode: standard
    emoji_allowed: true
    reporter: standard
    progress:
      enabled: true
      live: false
      force_text_task_updates: true
    stderr_colour: false
    diagnostics:
      colour: false
      unicode: true
      links: false
- policy: auto
  facts: stdout terminal
  plan:
    output_mode: standard
    emoji_allowed: true
    reporter: standard
    progress:
      enabled: true
      live: false
      force_text_task_updates: false
    stderr_colour: false
    diagnostics:
      colour: false
      unicode: true
      links: false
- policy: auto
  facts: stderr terminal
  plan:
    output_mode: standard
    emoji_allowed: true
    reporter: standard
    progress:
      enabled: true
      live: true
      force_text_task_updates: true
    stderr_colour: true
    diagnostics:
      colour: true
      unicode: true
      links: true
- policy: auto
  facts: terminal with NO_COLOR
  plan:
    output_mode: accessible
    emoji_allowed: false
    reporter: accessible
    progress:
      enabled: true
      live: false
      force_text_task_updates: true
    stderr_colour: false
